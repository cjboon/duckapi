{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "duck": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Duck.ai relay",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "{env:DUCKAI_API_KEY}"
      },
      "models": {
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna (Duck.ai)",
          "limit": { "context": 12000, "output": 2000 }
        }
      }
    }
  },
  "model": "duck/gpt-5.6-luna",
  "tools": { "webfetch": false, "task": false, "todowrite": false, "todoread": false }
}
